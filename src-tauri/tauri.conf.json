{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Encounters",
  "version": "0.1.0",
  "identifier": "com.encounters.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Encounters",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["encounters"] },
      "mobile": [{ "scheme": ["encounters"], "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
